# ============================================
# LEGALYZE BACKEND - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to `.env` in this directory and fill in real values.
# Never commit the real `.env`.

# ---- Database (required) ----
MONGODB_URI=<your-mongodb-atlas-connection-string>

# ---- JWT auth (required) ----
JWT_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_EXPIRY=2h
JWT_REFRESH_EXPIRY=30d
# Optional: a distinct secret for refresh tokens (derived from JWT_SECRET if unset)
JWT_REFRESH_SECRET=change-me-refresh-secret
# 32+ char random string for AES-256-GCM field encryption of sensitive PII at rest
ENCRYPTION_KEY=change-me-to-a-long-random-encryption-key
JWT_EXPIRE=7d

# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ---- OpenAI (required) ----
OPENAI_API_KEY=<your-openai-api-key>

# ---- Pinecone vector DB (required) ----
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=legal-documents
PINECONE_ENVIRONMENT=us-east-1

# ---- AWS S3 file storage (required) ----
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-north-1
AWS_BUCKET_NAME=your-s3-bucket-name

# ---- Google OAuth 2.0 (optional) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---- Email / SMTP (optional - password reset & notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
FROM_EMAIL=noreply@legalyze.com
FROM_NAME=Legalyze

# ---- Admin promotion code (optional) ----
ADMIN_SECRET_CODE=your_admin_secret_code

# =============================================================================
# Legalyze — UNIFIED environment template
# =============================================================================
# This is a TEMPLATE. It contains variable NAMES only, with empty values.
# The real .env (with secrets) is gitignored and must NEVER be committed.
#
# SETUP ON A NEW MACHINE / CLUSTER (after `git clone`):
#   1.  cp .env.example .env
#   2.  open .env and paste your real values (copy the full text of your
#       existing root .env from your other machine into this one file).
#   3.  For the backend app, point it at the same values:   cp .env backend/.env
#   4.  For the frontend app, create frontend/.env with just VITE_API_BASE_URL.
#
# For the RESEARCH pipeline only, the single root .env is enough (it supplies
# MONGODB_URI, OPENAI_API_KEY, and the PINECONE_* keys the retrieval layer needs).
# =============================================================================

# ---- Server ----
NODE_ENV=
PORT=
BACKEND_URL=
FRONTEND_URL=

# ---- Database (MongoDB Atlas) ----
MONGODB_URI=

# ---- Pinecone (vector DB) ----
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# ---- OpenAI (embeddings / generation) ----
OPENAI_API_KEY=

# ---- JWT auth ----
JWT_SECRET=
JWT_EXPIRE=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# ---- Email / SMTP ----
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=
